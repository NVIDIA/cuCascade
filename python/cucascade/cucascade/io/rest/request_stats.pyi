__all__ = ["RequestStats"]

class RequestStats:
    @property
    def attempts(self) -> int: ...
    @property
    def succeeded(self) -> int: ...
    @property
    def throttled(self) -> int: ...
    @property
    def http_client_errors(self) -> int: ...
    @property
    def http_server_errors(self) -> int: ...
    @property
    def timed_out(self) -> int: ...
    @property
    def transport_errors(self) -> int: ...
    @property
    def bytes(self) -> int: ...
    @property
    def max_total_ms(self) -> int: ...
    @property
    def latency_edges_ms(self) -> list[int]: ...
    @property
    def total_ms_histogram(self) -> list[int]: ...
    @property
    def first_byte_ms_histogram(self) -> list[int]: ...

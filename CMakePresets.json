{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 0,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_PREFIX_PATH": {
          "type": "PATH",
          "value": "$env{CMAKE_PREFIX_PATH}"
        },
        "CMAKE_CXX_COMPILER_LAUNCHER": "sccache",
        "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
        "CMAKE_CUDA_COMPILER_LAUNCHER": "sccache"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build/relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "asan",
      "displayName": "ASan + UBSan IO tests (CUDA host code)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CUCASCADE_BUILD_CUDF": "OFF",
        "CUCASCADE_BUILD_BENCHMARKS": "OFF",
        "CUCASCADE_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "$env{CXXFLAGS} -fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CUDA_FLAGS": "-Xcompiler=-fsanitize=address -Xcompiler=-fsanitize=undefined -Xcompiler=-fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "$env{LDFLAGS} -fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "$env{LDFLAGS} -fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "TSan IO tests",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CUCASCADE_BUILD_CUDF": "OFF",
        "CUCASCADE_BUILD_BENCHMARKS": "OFF",
        "CUCASCADE_BUILD_TESTS": "ON",
        "CMAKE_CXX_FLAGS": "$env{CXXFLAGS} -fsanitize=thread -fno-omit-frame-pointer -Wno-tsan",
        "CMAKE_CUDA_FLAGS": "-Xcompiler=-fsanitize=thread -Xcompiler=-fno-omit-frame-pointer -Xcompiler=-Wno-tsan",
        "CMAKE_EXE_LINKER_FLAGS": "$env{LDFLAGS} -fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "$env{LDFLAGS} -fsanitize=thread"
      }
    },
    {
      "name": "s3-bench",
      "displayName": "S3 benchmark (Release + aws-sdk-cpp)",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/s3-bench",
      "cacheVariables": {
        "CUCASCADE_BUILD_S3_BENCHMARK": "ON",
        "CUCASCADE_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}

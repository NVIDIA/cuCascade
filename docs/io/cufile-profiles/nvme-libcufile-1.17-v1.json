// cuCascade example profile v1, libcufile 1.17+ (Local NVMe (ext4/xfs)).
// Not a vendor-certified tuning prescription. Strip full-line comments before deployment.
// Engine preference: QD 32 / 4 MiB / 40 lanes; compare 2 MiB and 4 MiB on real GDS.
// max_direct_io_size_kb controls libcufile, NOT the engine's effective operation size.
// [verify] All numeric values must be qualified against this client, GDS stack and BAR1 budget.
// Reference: https://docs.nvidia.com/gpudirect-storage/configuration-guide/index.html
{
  "logging": {
    "level": "WARN"
  },
  "profile": {
    "cufile_stats": 0
  },
  "properties": {
    "allow_compat_mode": true,
    "max_direct_io_size_kb": 4096,
    "max_device_cache_size_kb": 131072,
    "max_device_pinned_mem_size_kb": 1048576
  }
}

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Find required dependencies for the cudf-free core (RMM + CUDA + numa).
find_dependency(CUDAToolkit REQUIRED VERSION 12.9)
find_dependency(Threads REQUIRED)
find_dependency(rmm REQUIRED CONFIG)

# The exported targets link the Numa::Numa imported target. Rerun the bundled
# FindNuma module so it is reconstructed against the consumer's libnuma instead
# of a path baked in at build time.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/Modules")
find_dependency(Numa REQUIRED)

# cudf is only a dependency of the optional cucascade-cudf library, so it is
# resolved lazily via the `cudf` package component. Plain
# find_package(cuCascade) loads the cudf-free core and never pulls cudf;
# find_package(cuCascade COMPONENTS cudf) additionally resolves cudf so the
# cuCascade::cucascade_cudf target can be linked. cuCascade_cudf_FOUND reflects
# whether the cudf-coupled library is available in this install.
set(cuCascade_cudf_FOUND @CUCASCADE_BUILD_CUDF@)
if(cuCascade_cudf_FOUND AND "cudf" IN_LIST cuCascade_FIND_COMPONENTS)
  find_dependency(cudf REQUIRED CONFIG)
endif()

# The optional cucascade-io library (uring/rest reactors, prefetching cache)
# is resolved lazily via the `io` package component, mirroring the cudf
# component above. The io core is cudf-free. The exported io targets reference
# the PkgConfig::LIBURING / PkgConfig::CURL imported targets by name, so they
# are reconstructed here with the same pkg_check_modules calls used at build
# time. The cudf component also needs these when io was built: cucascade_cudf
# links cucascade_io for the cudf::io::datasource bridge.
set(cuCascade_io_FOUND @CUCASCADE_BUILD_IO@)
if(cuCascade_io_FOUND AND ("io" IN_LIST cuCascade_FIND_COMPONENTS
                           OR "cudf" IN_LIST cuCascade_FIND_COMPONENTS))
  find_dependency(PkgConfig REQUIRED)
  pkg_check_modules(LIBURING REQUIRED IMPORTED_TARGET liburing)
  pkg_check_modules(CURL REQUIRED IMPORTED_TARGET libcurl)
  find_dependency(OpenSSL REQUIRED)
endif()

# moodycamel (concurrentqueue) headers are not shipped with the install: the io
# public headers include them via <cucascade/io/concurrent_queue.hpp>, so a
# consumer must provide the same moodycamel this install was built against
# (namespace @CUCASCADE_MOODYCAMEL_NAMESPACE@). Likewise, when the io library was
# built with CUCASCADE_USE_ABSEIL_INVOCABLE, cucascade::exec::invocable resolves
# to absl::AnyInvocable in the installed headers, so abseil must be available.
# The exported targets do not force-link either (the build-tree links are
# stripped); they only carry the matching compile definitions.
set(cuCascade_USE_ABSEIL_INVOCABLE @CUCASCADE_USE_ABSEIL_INVOCABLE@)
if(cuCascade_io_FOUND
   AND cuCascade_USE_ABSEIL_INVOCABLE
   AND ("io" IN_LIST cuCascade_FIND_COMPONENTS
        OR "cudf" IN_LIST cuCascade_FIND_COMPONENTS))
  find_dependency(absl CONFIG)
endif()

# Include the targets file
include("${CMAKE_CURRENT_LIST_DIR}/cuCascadeTargets.cmake")

# Provide a default target alias for convenience Users can link to
# cuCascade::cucascade, cuCascade::cucascade_static, or
# cuCascade::cucascade_shared
if(TARGET cuCascade::cucascade_shared)
  if(NOT TARGET cuCascade::cucascade)
    add_library(cuCascade::cucascade ALIAS cuCascade::cucascade_shared)
  endif()
elseif(TARGET cuCascade::cucascade_static)
  if(NOT TARGET cuCascade::cucascade)
    add_library(cuCascade::cucascade ALIAS cuCascade::cucascade_static)
  endif()
endif()
# Default alias for the cudf-coupled library (only present when
# CUCASCADE_BUILD_CUDF was ON)
if(TARGET cuCascade::cucascade_cudf_shared)
  if(NOT TARGET cuCascade::cucascade_cudf)
    add_library(cuCascade::cucascade_cudf ALIAS
                cuCascade::cucascade_cudf_shared)
  endif()
elseif(TARGET cuCascade::cucascade_cudf_static)
  if(NOT TARGET cuCascade::cucascade_cudf)
    add_library(cuCascade::cucascade_cudf ALIAS
                cuCascade::cucascade_cudf_static)
  endif()
endif()
# Default alias for the io library (only present when CUCASCADE_BUILD_IO was
# ON)
if(TARGET cuCascade::cucascade_io_shared)
  if(NOT TARGET cuCascade::cucascade_io)
    add_library(cuCascade::cucascade_io ALIAS cuCascade::cucascade_io_shared)
  endif()
elseif(TARGET cuCascade::cucascade_io_static)
  if(NOT TARGET cuCascade::cucascade_io)
    add_library(cuCascade::cucascade_io ALIAS cuCascade::cucascade_io_static)
  endif()
endif()
# Users can link to cuCascade::cucascade_topology_discovery,
# cuCascade::cucascade_topology_discovery_static, or
# cuCascade::cucascade_topology_discovery_shared
if(TARGET cuCascade::cucascade_topology_discovery_shared)
  if(NOT TARGET cuCascade::cucascade_topology_discovery)
    add_library(cuCascade::cucascade_topology_discovery ALIAS
                cuCascade::cucascade_topology_discovery_shared)
  endif()
elseif(TARGET cuCascade::cucascade_topology_discovery_static)
  if(NOT TARGET cuCascade::cucascade_topology_discovery)
    add_library(cuCascade::cucascade_topology_discovery ALIAS
                cuCascade::cucascade_topology_discovery_static)
  endif()
endif()

check_required_components(cuCascade)
